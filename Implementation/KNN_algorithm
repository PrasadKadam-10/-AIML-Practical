# Practical: K-Nearest Neighbors (KNN) Classifier
# Objective: Classify wine samples into their categories using KNN
#            and evaluate using accuracy, confusion matrix, and report.

import pandas as pd
from sklearn.datasets import load_wine
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import accuracy_score, confusion_matrix, classification_report

# --------------------------------------------------
# Step 1: Load the Wine dataset
# --------------------------------------------------
wine = load_wine()
X = wine.data    # 13 chemical properties
y = wine.target  # 3 wine classes

print("Number of samples :", X.shape[0])
print("Number of features:", X.shape[1])
print("Classes           :", list(wine.target_names))

# --------------------------------------------------
# Step 2: Split into training and test sets
# --------------------------------------------------
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=3)

# --------------------------------------------------
# Step 3: Scale features
# KNN is distance-based, so scaling is important.
# --------------------------------------------------
normalizer = StandardScaler()
X_train_n  = normalizer.fit_transform(X_train)
X_test_n   = normalizer.transform(X_test)

# --------------------------------------------------
# Step 4: Train KNN classifier
# --------------------------------------------------
num_neighbors = 7
knn_clf = KNeighborsClassifier(n_neighbors=num_neighbors)
knn_clf.fit(X_train_n, y_train)

# --------------------------------------------------
# Step 5: Predict on test data
# --------------------------------------------------
y_pred = knn_clf.predict(X_test_n)

# --------------------------------------------------
# Step 6: Evaluate the model
# --------------------------------------------------
acc    = accuracy_score(y_test, y_pred)
cm     = confusion_matrix(y_test, y_pred)
report = classification_report(y_test, y_pred,
                                target_names=wine.target_names)

print(f"\nK = {num_neighbors}")
print("Accuracy        :", round(acc, 4))
print("\nConfusion Matrix:\n", cm)
print("\nClassification Report:\n", report)
